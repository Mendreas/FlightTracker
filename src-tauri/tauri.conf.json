{
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../dist/",
    "distDir": "../dist/"
  },
  "package": {
    "productName": "Flight Track Viewer",
    "version": "2.5.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "pt.nav.flighttrackviewer",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Flight Track Viewer",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "fileDropEnabled": false
      }
    ]
  }
}
